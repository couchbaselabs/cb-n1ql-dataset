{
  "groups": [
    {
      "name": "Test Pipeline",
      "description": "Paths and settings for the cb-n1ql-dataset test runner itself",
      "variables": [
        {
          "key": "IQ_FASTAPI_PATH",
          "description": "Absolute path to the iQ-FastAPI directory",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_FASTAPI_PORT",
          "description": "Port to start iQ-FastAPI on",
          "required": false,
          "value": "8000"
        },
        {
          "key": "MCP_SERVER_PATH",
          "description": "Absolute path to the mcp-server-couchbase directory",
          "required": true,
          "value": ""
        },
        {
          "key": "PIPELINE_DATASET",
          "description": "Questions set to run: sqlite | snowflake | bird (maps to questions_<dataset>.json)",
          "required": false,
          "value": "sqlite"
        },
        {
          "key": "PIPELINE_TAG",
          "description": "Run name suffix appended to the runs/ folder name (e.g. v2 → runs/mcp_v2/)",
          "required": false,
          "value": ""
        },
        {
          "key": "PIPELINE_LIMIT",
          "description": "Max number of questions to process per run (0 = all)",
          "required": false,
          "value": "0"
        },
        {
          "key": "PIPELINE_WORKERS",
          "description": "Number of parallel workers for evaluation",
          "required": false,
          "value": "1"
        },
        {
          "key": "PIPELINE_TIMEOUT",
          "description": "Per-question timeout in seconds",
          "required": false,
          "value": "360"
        }
      ]
    },
    {
      "name": "iQ-FastAPI — Couchbase",
      "description": "Couchbase cluster that iQ-FastAPI connects to",
      "variables": [
        {
          "key": "IQ_COUCHBASE_CONNECTION_STRING",
          "description": "iQ-FastAPI Couchbase connection string (e.g. couchbases://...)",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_DB_USERNAME",
          "description": "iQ-FastAPI Couchbase username",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_DB_PASSWORD",
          "description": "iQ-FastAPI Couchbase password",
          "required": true,
          "value": "",
          "secret": true
        },
        {
          "key": "IQ_BUCKET_NAME",
          "description": "Primary bucket name for iQ-FastAPI",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_SCOPE_NAME",
          "description": "Scope name for iQ-FastAPI",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_COLLECTION_NAME",
          "description": "Collection name for iQ-FastAPI",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_CATALOG_COLLECTION_NAME",
          "description": "Catalog collection name for iQ-FastAPI",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_SEARCH_INDEX_NAME",
          "description": "Search index name for iQ-FastAPI",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_CERT_PATH",
          "description": "Path to Couchbase TLS certificate for iQ-FastAPI",
          "required": false,
          "value": ""
        }
      ]
    },
    {
      "name": "iQ-FastAPI — Persistence",
      "description": "Separate Couchbase cluster used by iQ-FastAPI for conversation persistence",
      "variables": [
        {
          "key": "IQ_CB_PERSISTENCE_CONN_STR",
          "description": "Couchbase connection string for persistence",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_CB_PERSISTENCE_USERNAME",
          "description": "Couchbase username for persistence",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_CB_PERSISTENCE_PASSWORD",
          "description": "Couchbase password for persistence",
          "required": false,
          "value": "",
          "secret": true
        },
        {
          "key": "IQ_CB_PERSISTENCE_BUCKET_NAME",
          "description": "Bucket name for persistence",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_CB_PERSISTENCE_SCOPE_NAME",
          "description": "Scope name for persistence",
          "required": false,
          "value": ""
        }
      ]
    },
    {
      "name": "iQ-FastAPI — LLM",
      "description": "Model configuration for iQ-FastAPI",
      "variables": [
        {
          "key": "IQ_LLM_PROVIDER",
          "description": "LLM provider for iQ-FastAPI (e.g. openai, bedrock)",
          "required": true,
          "value": "openai"
        },
        {
          "key": "IQ_LLM_MODEL",
          "description": "LLM model name for iQ-FastAPI",
          "required": true,
          "value": ""
        },
        {
          "key": "IQ_LLM_REASONING_EFFORT",
          "description": "Reasoning effort for iQ-FastAPI LLM (low/medium/high, leave blank to disable)",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_ORCHESTRATOR_LLM_PROVIDER",
          "description": "LLM provider for the orchestrator agent",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_ORCHESTRATOR_LLM_MODEL",
          "description": "LLM model for the orchestrator agent",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_ORCHESTRATOR_LLM_REASONING_EFFORT",
          "description": "Reasoning effort for the orchestrator agent",
          "required": false,
          "value": ""
        }
      ]
    },
    {
      "name": "iQ-FastAPI — API Keys",
      "description": "API keys and cloud credentials for iQ-FastAPI",
      "variables": [
        {
          "key": "IQ_OPENAI_API_KEY",
          "description": "OpenAI API key for iQ-FastAPI",
          "required": false,
          "value": "",
          "secret": true
        },
        {
          "key": "IQ_AWS_ACCESS_KEY_ID",
          "description": "AWS access key ID (for Bedrock)",
          "required": false,
          "value": "",
          "secret": true
        },
        {
          "key": "IQ_AWS_SECRET_ACCESS_KEY",
          "description": "AWS secret access key (for Bedrock)",
          "required": false,
          "value": "",
          "secret": true
        },
        {
          "key": "IQ_AWS_REGION",
          "description": "AWS region (for Bedrock)",
          "required": false,
          "value": ""
        }
      ]
    },
    {
      "name": "iQ-FastAPI — LangSmith",
      "description": "LangSmith tracing and evaluation (optional)",
      "variables": [
        {
          "key": "IQ_LANGSMITH_API_KEY",
          "description": "LangSmith API key",
          "required": false,
          "value": "",
          "secret": true
        },
        {
          "key": "IQ_LANGSMITH_PROJECT",
          "description": "LangSmith project name",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_LANGSMITH_ENDPOINT",
          "description": "LangSmith endpoint URL",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_LANGSMITH_DATASET_ID",
          "description": "LangSmith dataset ID",
          "required": false,
          "value": ""
        },
        {
          "key": "IQ_LANGSMITH_TRACING",
          "description": "Enable LangSmith tracing (true/false)",
          "required": false,
          "value": "false"
        },
        {
          "key": "IQ_LANGSMITH_TRACING_V2",
          "description": "Enable LangSmith tracing v2 (true/false)",
          "required": false,
          "value": "false"
        }
      ]
    },
    {
      "name": "MCP Server — Couchbase",
      "description": "Couchbase cluster that the MCP server connects to (separate from iQ-FastAPI)",
      "variables": [
        {
          "key": "MCP_CB_CONNECTION_STRING",
          "description": "MCP server Couchbase connection string (maps to CB_CONNECTION_STRING)",
          "required": true,
          "value": ""
        },
        {
          "key": "MCP_CB_USERNAME",
          "description": "MCP server Couchbase username (maps to CB_USERNAME)",
          "required": true,
          "value": ""
        },
        {
          "key": "MCP_CB_PASSWORD",
          "description": "MCP server Couchbase password (maps to CB_PASSWORD)",
          "required": true,
          "value": "",
          "secret": true
        },
        {
          "key": "MCP_CB_CA_CERT_PATH",
          "description": "Path to CA certificate for MCP server Couchbase TLS (maps to CB_CA_CERT_PATH)",
          "required": false,
          "value": ""
        },
        {
          "key": "MCP_CB_AGENT_BASE_URL",
          "description": "iQ-FastAPI base URL that the MCP server calls for query generation (maps to CB_AGENT_BASE_URL)",
          "required": true,
          "value": "http://localhost:8000"
        },
        {
          "key": "MCP_CB_AGENT_REQUEST_TIMEOUT_SECONDS",
          "description": "Timeout in seconds for MCP → iQ-FastAPI requests (maps to CB_AGENT_REQUEST_TIMEOUT_SECONDS)",
          "required": false,
          "value": "300"
        }
      ]
    }
  ]
}
